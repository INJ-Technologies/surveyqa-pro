# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=change-me
# Alternatively point to a mounted secret/file:
# REDIS_PASSWORD_FILE=/run/secrets/redis_password_secret

# Docker Swarm secrets (alternative to env vars)
# Mount these at runtime (default Swarm path is /run/secrets/<name>):
# - /run/secrets/redis_host
# - /run/secrets/redis_username
# - /run/secrets/redis_password_secret
